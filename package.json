{
  "name": "gameshelf",
  "productName": "GameShelf",
  "version": "0.1.0",
  "description": "A local-first private game library for Windows.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "kevincsq",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-squirrel-startup": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-squirrel": "latest",
    "@electron-forge/maker-zip": "latest",
    "@electron-forge/plugin-vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
